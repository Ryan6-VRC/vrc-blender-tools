# Python
__pycache__/
*.py[cod]
*.egg-info/

# Blender junk
*.blend1
*.blend2

# Per-avatar test fixtures are never committed; Felis (negated below) is the one that is.
tests/fixtures/*.blend
tests/fixtures/*.fbx

# Build / output artifacts
/out/
*.fbx
*.zip

# Negation must follow the *.fbx rule.
!tests/fixtures/Felis/
!tests/fixtures/Felis/Felis.fbx

# Provisioned by tools/provision_deps.py.
/deps/
/avatarprep/wheels/

# OS junk
.DS_Store
Thumbs.db

# Git worktrees (isolated workspaces)
.worktrees/
